# Telegram боты
ADMIN_BOT_TOKEN=your_admin_bot_token
CLIENT_BOT_TOKEN=your_client_bot_token

# ID администраторов (через запятую)
ALLOWED_IDS=123456789,987654321

# 3x-ui Сервер 1
XUI_URL_1=https://your-server-1-ip:port/panel-path
XUI_USER_1=your_xui_username
XUI_PASS_1=your_xui_password
SERVER_IP_1=your-server-1-ip
SERVER_PORT_1=443

# 3x-ui Сервер 2
XUI_URL_2=https://your-server-2-ip:port/panel-path
XUI_USER_2=your_xui_username
XUI_PASS_2=your_xui_password
SERVER_IP_2=your-server-2-ip
SERVER_PORT_2=32739

# Fornex API
FORNEX_API_KEY=your_fornex_api_key
FORNEX_ORDER_URL_1=https://fornex.com/api/orders/vps/your-order-1/
FORNEX_ORDER_URL_2=https://fornex.com/api/orders/vps/your-order-2/
